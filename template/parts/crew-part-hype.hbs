<section class="slugblasterHype">
  <h2>{{ localize 'Slugblaster.Actor.Dicepool.Hype' }}</h2>
	<div class="attributes">
    {{#numLoop boostMax}}
			{{{my_icon "boost" this ../actor.system.boost null}}}
    {{/numLoop}}
  </div>
  {{#if (eq actor.system.boosts -1) }}
  <div class="boosting">
    {{{my_icon "boost active" null}}}
  </div>
  {{/if}}
  <div class="attributes">
    {{#numLoop kickMax}}
			{{{my_icon "kick" this ../actor.system.kick null }}}
    {{/numLoop}}
  </div>
</section>