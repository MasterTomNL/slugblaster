<section class="slugblasterDice">
  <h2>{{ localize 'Slugblaster.Actor.Dicepool.TabName' }}</h2>
  <div class="btn-group">
    <button class="btn" data-action="minusDice" data-type="dicePool">-</button>
    <button class="btn" data-action="rollDice" data-type="dicePool">
      {{ localize 'Slugblaster.Actor.Dicepool.Roll' }}
      {{ actor.system.dicePool}}
      {{#if (eq actor.system.dicePool 1) }}
        {{ localize 'Slugblaster.Actor.Dicepool.Die' }}
      {{/if}}
      {{#if (gt actor.system.dicePool 1) }}
        {{ localize 'Slugblaster.Actor.Dicepool.Dice' }}
      {{/if}}
      !
    </button>
    <button class="btn" data-action="plusDice" data-type="dicePool">+</button>
  </div>
  <div class="dice">
    {{#numLoop actor.system.dicePool}}
      {{{my_icon "dice" null }}}
    {{/numLoop}}
  </div>
</section>