<section class="tab {{tabs.signature.id}} {{tabs.signature.cssClass}}" data-tab="{{tabs.signature.id}}" data-group="{{tabs.signature.group}}">
  {{> "systems/slugblaster/template/parts/actor-part-stash.hbs" }}
  {{#each signatures as |item key|}}
  <div class="signatureHeader">
    <img class="signatureImg" src="{{item.img}}" data-action="editImage" data-field="img" data-item-id="{{ item._id }}" height=100 width=100 >
    <div class="signatureDetails">
      <h2>
        {{item.name}}
        {{#if ../editable}}<i class="fas fa-trash" data-action="deleteItem" title="{{ localize 'Slugblaster.Delete' }}" data-item-id="{{ item._id }}""></i>{{/if}}
      </h2>
      <p>{{item.system.description}}</p>
      <input type="hidden" name="items.{{item._id}}.name" value="{{item.name}}">
      <input type="text" name="items.{{item._id}}.system.look" value="{{item.system.look}}" placeholder="{{ localize 'Slugblaster.Actor.SignatureDevice.LookPlaceholder' }}">
    </div>
  </div>
  <div class="signatureTurbo">
    <h3>Turbo</h3>
    <div class="flexrow">
      <div class="attributes">
        {{#numLoop 5}}
          {{{my_icon "boosts" this item.system.boosts item._id}}}
        {{/numLoop}}
      </div>
      <div class="attributes">
        {{#numLoop 5}}
          {{{my_icon "kicks" this item.system.kicks item._id}}}
        {{/numLoop}}
      </div>
    </div>
  </div>
  <div class="signatureMods">
    <h3>
      {{ localize 'Slugblaster.Actor.SignatureDevice.Mods' }}
      {{#if ../editable}}<i class="fas fa-plus" data-action="addSignatureMod" data-parent-id="{{item._id}}"></i>{{/if}}
    </h3>
    <ul>
      {{#each item.mods as |mod key|}}
      <li class="list-item sigMod {{ isUnlocked mod.system.active }}" data-item-id="{{mod._id}}">
        <div class="static">
          <span class="name">{{mod.name}}</span>
          {{#unless mod.system.custom}}
            {{#unless mod.system.active }}
            <i class="fas fa-download install {{ hideOrDisable ../../actor.system mod.system }}" data-action="installMod" data-item-id="{{mod._id}}" title="{{ localize 'Slugblaster.Actor.SignatureDevice.Install' }}"></i>
            {{/unless }}
            
            {{#if mod.system.active }}
            <i class="fas fa-recycle salvage" data-action="salvageMod" data-item-id="{{mod._id}}" title="{{ localize 'Slugblaster.Actor.SignatureDevice.Salvage' }}"></i>
            {{/if}}
            
            <span>(</span>
            <span class="{{#if (eq mod.system.coil 0)}}hidden{{/if}}">
              {{#numLoop mod.system.coil}}
                {{{my_icon "coil" 'Slugblaster.Coil' 0}}}
              {{/numLoop}}
            </span>
            <span class="{{#if (eq mod.system.disc 0)}}hidden{{/if}}">
              {{#numLoop mod.system.disc}}
                {{{my_icon "disc" 'Slugblaster.Disc' 0}}}
              {{/numLoop}}
            </span>
            <span class="{{#if (eq mod.system.gem 0)}}hidden{{/if}}">
              {{#numLoop mod.system.gem}}
                {{{my_icon "gem" 'Slugblaster.Gem' 0}}}
              {{/numLoop}}
            </span>
            <span class="{{#if (eq mod.system.lens 0)}}hidden{{/if}}">
              {{#numLoop mod.system.lens}}
                {{{my_icon "lens" 'Slugblaster.Lens' 0}}}
              {{/numLoop}}
            </span>
            <span>)</span>
          {{/unless}}
          {{#if (and ../../editable mod.system.custom)}}<i class="fas fa-edit" data-action="editItem"></i>{{/if}}
          {{#if (and ../../editable mod.system.custom)}}<i class="fas fa-trash" data-action="deleteItem" data-item-id="{{mod._id}}"></i>{{/if}}
          <p class="desc">{{mod.system.description}}</p>
        </div>
        {{#if mod.system.custom}}
        <div class="fluid">
          <div class="flexcontainer">
            <input type="text" name="items.{{mod._id}}.name" value="{{mod.name}}">
            <i class="fas fa-save" data-action="saveItem"></i>
          </div>
          <textarea name="items.{{mod._id}}.system.description">{{mod.system.description}}</textarea>
        </div>
        {{/if}}
      </li>
      {{/each}}
    </ul>
  </div>
  {{/each}}
</div>