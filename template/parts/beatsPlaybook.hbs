<section class="slugblasterBeats">
  <h3>
    {{ localize beatName }}
    <i class="fas fa-plus" data-action="addBeat" data-type="{{beatName}}" title="{{ localize 'Slugblaster.Add' }}"></i>
  </h3>
  <ul>
    <li class="flexrow">
      <label class="flex2">{{ localize 'Slugblaster.Name' }}</label>
      <label class="al-c">{{ localize 'Slugblaster.Trouble' }}</label>
      <label class="al-c">{{ localize 'Slugblaster.Style' }}</label>
      <label class="flex2">{{ localize 'Slugblaster.Reward' }}</label>
      <div class="flex0"></div>
    </li>
      
    {{#each beats as |beat bId|}}
    <li class="beatRow">
      <div class="flexrow">
        <input name="items.{{beat._id}}.name" class="flex2" type="text" value="{{beat.name}}" />
        <input name="items.{{beat._id}}.system.troubleCost" class="al-c" type="text" value="{{beat.system.troubleCost}}" />
        <input name="items.{{beat._id}}.system.styleCost" class="al-c" type="text" value="{{beat.system.styleCost}}" />
        <input name="items.{{beat._id}}.system.reward" class="flex2" type="text" value="{{beat.system.reward}}" placeholder="{{ localize 'SB.newBeatReward' }}" />
        <i class="fas fa-trash" data-action="deleteItem" title="{{ localize 'Slugblaster.Delete' }}" data-item-id="{{beat._id}}"></i>
      </div>
      <textarea data-name="items.{{beat._id}}.system.description">{{ beat.system.description }}</textarea>
    </li>
    {{/each}}
  </ul>
</section>